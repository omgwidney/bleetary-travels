# Copy this file to .env.local for local development.
# Use separate values in Vercel Preview and Production environments.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-me
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-me.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=replace-me
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Server-only Firebase Admin credentials. Never prefix these with NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=replace-me
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=replace-me.firebasestorage.app

# For local emulator development:
# 1. Set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# 2. Override project IDs to match the emulator project (e.g. demo-bleetary):
#    NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-bleetary
#    FIREBASE_ADMIN_PROJECT_ID=demo-bleetary
#    GOOGLE_CLOUD_PROJECT=demo-bleetary
# 3. Uncomment and set these server-side emulator hosts:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
