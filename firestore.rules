rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isHost() {
      return role() == "host";
    }

    function isPublished() {
      return resource.data.status == "published";
    }

    function owns(field) {
      return signedIn() && resource.data[field] == uid();
    }

    function hostOwnsRecord() {
      return isHost() &&
        (
          resource.data.ownerUid == uid() ||
          resource.data.hostUid == uid()
        );
    }

    function travelerOwnsRecord() {
      return signedIn() &&
        (
          resource.data.ownerUid == uid() ||
          resource.data.travelerUid == uid()
        );
    }

    match /host_leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          "name",
          "email",
          "hasCommunity",
          "communityStage",
          "source",
          "createdAt"
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.hasCommunity in ["yes", "no"] &&
        request.resource.data.communityStage in [
          "full-time",
          "side-project",
          "building",
          "exploring"
        ] &&
        request.resource.data.source == "host_quiz" &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /hostApplications/{applicationId} {
      allow read: if owns("ownerUid") || isAdmin();
      allow create, update, delete: if false;
    }

    match /hostProfiles/{profileId} {
      allow read: if isPublished() || owns("ownerUid") || isAdmin();
      allow create, update, delete: if false;
    }

    match /destinations/{documentId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if false;
    }

    match /itineraries/{documentId} {
      allow read: if isPublished() || hostOwnsRecord() || isAdmin();
      allow create, update, delete: if false;
    }

    match /trips/{documentId} {
      allow read: if isPublished() || hostOwnsRecord() || isAdmin();
      allow create, update, delete: if false;
    }

    match /tripDepartures/{documentId} {
      allow read: if isPublished() || hostOwnsRecord() || isAdmin();
      allow create, update, delete: if false;
    }

    match /interestResponses/{documentId} {
      allow read: if travelerOwnsRecord() || hostOwnsRecord() || isAdmin();
      allow create, update, delete: if false;
    }

    match /bookings/{documentId} {
      allow read: if travelerOwnsRecord() || hostOwnsRecord() || isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentSchedules/{documentId} {
      allow read: if travelerOwnsRecord() || hostOwnsRecord() || isAdmin();
      allow create, update, delete: if false;
    }

    match /payments/{documentId} {
      allow read: if travelerOwnsRecord() || hostOwnsRecord() || isAdmin();
      allow create, update, delete: if false;
    }

    match /referrals/{documentId} {
      allow read: if signedIn() &&
        (
          resource.data.referrerUid == uid() ||
          resource.data.referredUid == uid() ||
          isAdmin()
        );
      allow create, update, delete: if false;
    }

    match /supportArticles/{documentId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if false;
    }

    match /auditEvents/{documentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
